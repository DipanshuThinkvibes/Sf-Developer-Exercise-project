<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Review_Year_Must_Be_Valid</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    Review_Year__c &lt; 2000,
    Review_Year__c &gt; 2100
)</errorConditionFormula>
    <errorDisplayField>Review_Year__c</errorDisplayField>
    <errorMessage>Enter a review year between 2000 and 2100.</errorMessage>
</ValidationRule>
