<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Achievement_Note_Max_Length</fullName>
    <active>true</active>
    <errorConditionFormula>LEN(Note__c) &gt; 255</errorConditionFormula>
    <errorDisplayField>Note__c</errorDisplayField>
    <errorMessage>Note cannot exceed 255 characters.</errorMessage>
</ValidationRule>
