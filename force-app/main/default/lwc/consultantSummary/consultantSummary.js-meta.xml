<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>Consultant Summary</masterLabel>
    <description>Displays consultant fields dynamically from a Field Set.</description>

    <targets>
        <target>lightning__RecordPage</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">

            <objects>
                <object>Consultant__c</object>
                <object>Talent_Review__c</object>
            </objects>

            <property
                name="title"
                type="String"
                label="Title"
                default="Consultant Summary"/>

            <property
                name="showHeader"
                type="Boolean"
                label="Show Header"
                default="true"/>

            <property
                name="columns"
                type="String"
                label="Columns"
                datasource="1,2,3"
                default="2"/>

            <property
                name="fieldSetName"
                type="String"
                label="Field Set"
                datasource="apex://ConsultantFieldSetPicklist"
                default="Consultant_Summary_Fields"/>

        </targetConfig>
    </targetConfigs>

</LightningComponentBundle>
